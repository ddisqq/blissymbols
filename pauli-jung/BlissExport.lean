import PauliJung.Symbols

/-!
# `blissexport`: Lean's side of the 3D symbol set

Writes a JavaScript data file for the 3D viewer in `../bliss3d`:

* every Blissymbol character, flattened by `Bliss.flatten` into positioned
  primitive paths (the function whose totality rests on `Bliss.items_wf`);
* every word, expanded by `Bliss.expandWord` into its characters;
* the Pauli–Jung cases as Blissymbol sentences, with the link symbol
  computed by the decision procedure.

    lake exe blissexport > ../bliss3d/bliss3d_data.js
-/

open Bliss PauliJung

def jstr (s : String) : String :=
  "\"" ++ (s.replace "\\" "\\\\").replace "\"" "\\\"" ++ "\""

def jbool (b : Bool) : String := if b then "true" else "false"

/-- Strokes of a character, as `[prim, x, y]` triples. -/
def glyphJson (c : CharEntry) : String :=
  let strokes : List Stroke :=
    if h : c.item < items.length then itemStrokes c.item h else []
  let body := ",".intercalate (strokes.map fun s => s!"[{s.prim},{s.x},{s.y}]")
  s!"{jstr c.name}:\{\"w\":{c.w},\"h\":{c.h},\"s\":[{body}]}"

/-- Each word with its characters (indices into `charNames`), expanded by
`Bliss.expandWord`. -/
def wordRows : Nat → List (String × List WRef) → List String
  | _, [] => []
  | i, w :: rest =>
    let cs : List Nat := if h : i < words.length then wordChars i h else []
    s!"{jstr w.1}:[{",".intercalate (cs.map toString)}]" :: wordRows (i + 1) rest

def sentenceJson (s : Sentence) : String :=
  s!"\{\"title\":{jstr s.title},\"mental\":{jstr s.mental},\"link\":{jstr s.link}," ++
  s!"\"physical\":{jstr s.physical},\"archetype\":{jstr s.archetype}," ++
  s!"\"sync\":{jbool s.sync},\"meaningful\":{jbool s.meaningful},\"linked\":{jbool s.linked}}"

def main : IO Unit := do
  let out ← IO.getStdout
  out.putStrLn "// Generated by `lake exe blissexport` (pauli-jung/BlissExport.lean). Do not edit."
  out.putStrLn "// Coordinates are in thousandths of a Blissymbol unit."
  out.putStrLn "var BLISS3D_DATA = {"
  out.putStrLn s!"\"counts\":\{\"prims\":{primNames.length},\"items\":{items.length},\"chars\":{chars.length},\"words\":{words.length}},"
  out.putStrLn s!"\"prims\":[{",".intercalate (primNames.map jstr)}],"
  out.putStrLn "\"glyphs\":{"
  out.putStrLn (",\n".intercalate (chars.map glyphJson))
  out.putStrLn "},"
  out.putStrLn "\"charNames\":["
  out.putStrLn (",".intercalate (chars.map fun c => jstr c.name))
  out.putStrLn "],"
  out.putStrLn "\"words\":{"
  out.putStrLn (",\n".intercalate (wordRows 0 words))
  out.putStrLn "},"
  out.putStrLn s!"\"symbols\":\{\"meaning\":{jstr symMeaning},\"cause\":{jstr symCause},\"chance\":{jstr symChance},\"mind\":{jstr symMind},\"matter\":{jstr symMatter}},"
  out.putStrLn "\"sentences\":["
  out.putStrLn (",\n".intercalate (sentences.map sentenceJson))
  out.putStrLn "]};"
